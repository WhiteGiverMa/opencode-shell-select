  "devDependencies": {
    "@opencode/plugin": "2.3.0",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.6",
    "@types/which": "3.0.4",
    "effect": "4.1.0",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  }
}
